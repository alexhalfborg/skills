{
  "mcpServers": {
    "fal-ai": {
      "type": "http",
      "url": "https://mcp.fal.ai/mcp-relay"
    },
    "pexels": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@hanoak/pexels-mcp-server@1.0.2"],
      "env": {
        "PEXELS_API_KEY": "${user_config.pexels_key}"
      }
    },
    "pixabay": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@hanoak/pixabay-mcp-server@1.0.1"],
      "env": {
        "PIXABAY_API_KEY": "${user_config.pixabay_key}"
      }
    },
    "meta": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mikusnuz/meta-mcp@2.2.2"],
      "env": {
        "INSTAGRAM_ACCESS_TOKEN": "${user_config.instagram_access_token}",
        "INSTAGRAM_USER_ID": "${user_config.instagram_user_id}",
        "THREADS_ACCESS_TOKEN": "${user_config.threads_access_token}",
        "THREADS_USER_ID": "${user_config.threads_user_id}"
      }
    }
  }
}
